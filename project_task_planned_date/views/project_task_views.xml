<odoo>
    <record id="view_task_form2" model="ir.ui.view">
        <field name="name">project.task.form.planned.date</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//label[@for='date_deadline']" position="before">
                <field
                    name="planned_date_start"
                    widget="daterange"
                    options="{'end_date_field': 'planned_date_end'}"
                    string="Planned Dates"
                />
                <field name="planned_date_end" invisible="1" />
            </xpath>
        </field>
    </record>
    <record id="view_task_tree2" model="ir.ui.view">
        <field name="name">project.task.list.planned.date</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2" />
        <field name="arch" type="xml">
            <field name="date_deadline" position="after">
                <field name="planned_date_start" optional="hide" />
                <field name="planned_date_end" optional="hide" />
            </field>
        </field>
    </record>
    <record id="view_task_search_form" model="ir.ui.view">
        <field name="name">project.task.search.planned.date</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form_project_base" />
        <field name="arch" type="xml">
            <filter name="date_deadline" position="after">
                <separator />
                <filter
                    string="Planned"
                    name="planned"
                    domain="[('planned_date_start', '!=', False)]"
                />
                <filter
                    string="Not Planned"
                    name="not_planned"
                    domain="[('planned_date_start', '=', False)]"
                />
                <filter
                    string="Planned Start"
                    name="planned_date_start_filter"
                    date="planned_date_start"
                />
            </filter>
            <filter name="deadline" position="after">
                <filter
                    string="Planned Start"
                    name="groupby_planned_date_start"
                    context="{'group_by': 'planned_date_start:week'}"
                />
            </filter>
        </field>
    </record>
</odoo>
